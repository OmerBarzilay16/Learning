# Storage must be globally unique; suffix keeps it unique per run
RAND_SUFFIX="$(date +%s)"
STG="stg${RAND_SUFFIX}peolab"

# your current public IP (used to allow SSH in NSG)
# If this returns blank on your network, replace manually with your IP.
MYIP="$(curl -s ifconfig.me)"
