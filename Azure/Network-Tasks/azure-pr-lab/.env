# ===== lab variables =====
SUBSCRIPTION="Sapir_Subscription01"
RG="Sapir-pe-lab"
LOC="westeurope"

VNET="vnet-pe-lab"
ADDR="10.20.0.0/16"

SUBNET_VM="snet-workload"
CIDR_VM="10.20.1.0/24"

SUBNET_PE="snet-pe"
CIDR_PE="10.20.2.0/24"

NSG="nsg-workload"

VM_NAME="vm-pe-test"
IMG="Ubuntu2204"
